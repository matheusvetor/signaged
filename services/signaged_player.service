[Unit]
Description=Signaged Player Service
After=network.target
StartLimitIntervalSec=0

[Service]
Type=simple
Restart=always
RestartSec=1
User=root
WorkingDirectory=/home/tvopen/signaged
ExecStart=/usr/local/bin/ruby  /home/tvopen/signaged/bin/signaged_player.rb

[Install]
WantedBy=multi-user.target
