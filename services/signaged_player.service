[Unit]
Description=Signaged Player Service
After=network.target
StartLimitIntervalSec=0

[Service]
Type=simple
Restart=always
RestartSec=1
User=root
WorkingDirectory=@SIGNAGED_ROOT@
ExecStartPre=/usr/bin/chvt 2
ExecStart=/usr/local/bin/ruby  @SIGNAGED_ROOT@/bin/signaged_player.rb

[Install]
WantedBy=multi-user.target
