#!/usr/bin/env bash
set -euo pipefail

# Keep the player-facing fbi command while using DRM for image scanout in VirtualBox.
original=("$@")
tty=
while (($#)); do
    case "$1" in
        -T)
            tty=${2-}
            [[ "$tty" =~ ^[1-9][0-9]*$ ]] || exit 2
            shift 2
            ;;
        -a|-noverbose|--noverbose)
            shift
            ;;
        -reset|--reset|--once|-h|--help)
            exec /usr/local/libexec/fbi-vetor "${original[@]}"
            ;;
        --)
            shift
            break
            ;;
        -*)
            exec /usr/local/libexec/fbi-vetor "${original[@]}"
            ;;
        *)
            break
            ;;
    esac
done

if (($# != 1)); then
    exec /usr/local/libexec/fbi-vetor "${original[@]}"
fi

if [[ -n "$tty" ]]; then
    /usr/bin/chvt "$tty"
fi
exec /usr/bin/mpv --no-config --vo=drm --sws-scaler=fast-bilinear \
    --no-terminal --no-input-default-bindings --no-audio --image-display-duration=inf -- "$1"
